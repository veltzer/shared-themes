{
  "ignoreFiles": [
    "**/shared/shared-themes/themes.css",
    "**/node_modules/**"
  ],
  "rules": {
    "declaration-property-value-allowed-list": {
      "/^color$/": [
        "/^var\\(--(text-primary|text-secondary|text-muted|accent|accent-dim|success|success-dim|warning|warning-dim|danger|danger-dim|gradient-start|gradient-end)\\)/",
        "/^(transparent|currentColor|inherit|initial|unset)$/"
      ],
      "/^background(-color)?$/": [
        "/^var\\(--(bg|bg-surface|bg-elevated|bg-hover|accent|accent-dim|success|success-dim|warning|warning-dim|danger|danger-dim|code-bg|surface)\\)/",
        "/^(transparent|inherit|initial|unset|none)$/",
        "/^linear-gradient/",
        "/^radial-gradient/",
        "/^url\\(/"
      ],
      "/^border(-color|-top-color|-right-color|-bottom-color|-left-color)?$/": [
        "/^var\\(--(border|border-subtle|accent|success|warning|danger)\\)/",
        "/^(transparent|currentColor|inherit|initial|unset|none)$/",
        "/^[0-9]/"
      ],
      "/^outline(-color)?$/": [
        "/^var\\(--(border|accent|success|warning|danger)\\)/",
        "/^(transparent|currentColor|inherit|initial|unset|none)$/",
        "/^[0-9]/"
      ],
      "/^fill$/": [
        "/^var\\(--/",
        "/^(transparent|currentColor|inherit|initial|unset|none)$/",
        "/^url\\(/"
      ],
      "/^stroke$/": [
        "/^var\\(--/",
        "/^(transparent|currentColor|inherit|initial|unset|none)$/"
      ]
    },
    "color-no-hex": [true, { "message": "Raw hex colors are forbidden. Use var(--<role>) from shared-themes." }],
    "color-named": ["never", { "message": "Named colors are forbidden. Use var(--<role>) from shared-themes." }]
  }
}
