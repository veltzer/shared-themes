// Design-token rules for biome (GritQL plugin), the Rust replacement for the
// former stylelint config. Every themed stylesheet must take its colors,
// fonts, radii, shadows and transitions from the var(--<role>) tokens that
// themes.css defines; themes.css itself holds the raw values and is not
// linted with these rules.
//
// Grit regexes match the whole node text, so stylelint's unanchored
// patterns are written here as .*pattern.* and its ^...$ patterns as-is.
// Keep the token lists in sync with themes.yaml; test_tokens_allowlist.css
// uses every allowed token and fails the build if the two drift apart.
language css

or {
    // declaration-property-value-allowed-list: per property, the value must
    // match one of the allowed forms
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:color|background|background-color|fill|stroke|outline-color|caret-color|column-rule-color|text-decoration-color)",
        not $value <: or {
                r"(?s).*var\(--(?:bg|bg-surface|bg-elevated|bg-hover|surface|code-bg|border|border-subtle|text-primary|text-secondary|text-muted|accent|accent-dim|success|success-dim|warning|warning-dim|danger|danger-dim|gradient-start|gradient-end|info|info-dim)\).*",
                r"(?:transparent|currentColor|inherit|initial|unset|none)",
                r"(?s)(?:linear|radial|conic)-gradient\([^#]*var\(--[a-z-]+\).*",
                r"(?s)url\(.*"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:border|border-color|border-top-color|border-right-color|border-bottom-color|border-left-color|outline)",
        not $value <: or {
                r"(?s).*var\(--(?:border|border-subtle|accent|accent-dim|success|warning|danger|info|text-muted)\).*",
                r"(?:transparent|currentColor|inherit|initial|unset|none)",
                r"(?s)[0-9].*"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:box-shadow|text-shadow)",
        not $value <: or {
                r"(?s).*var\(--shadow\).*",
                r"(?s)[0-9].*",
                r"(?:none|inherit|initial|unset)"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:font-family)",
        not $value <: or {
                r"(?s).*var\(--font-(?:sans|mono)\).*",
                r"(?:inherit|initial|unset)"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:border-radius|border-top-left-radius|border-top-right-radius|border-bottom-right-radius|border-bottom-left-radius)",
        not $value <: or {
                r"(?s).*var\(--radius(?:-xs|-sm|-pill)?\).*",
                r"(?:0|0px|50%|inherit|initial|unset)"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:transition)",
        not $value <: or {
                r"(?s).*var\(--transition(?:-slow)?\).*",
                r"(?:none|inherit|initial|unset|all)"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    CssGenericProperty(name=$name, value=$value) as $decl where {
        $name <: r"(?:transition-duration)",
        not $value <: or {
                r"(?s).*var\(--transition(?:-slow)?\).*",
                r"(?:inherit|initial|unset)"
        },
        register_diagnostic(span=$decl, message="Use a var(--<role>) token from shared-themes for this property.")
    },
    // color-no-hex
    CssColor() as $hex where {
        register_diagnostic(span=$hex, message="Raw hex colors are forbidden. Use var(--<role>) from shared-themes.")
    },
    // function-disallowed-list
    CssFunction(name=$fn) as $call where {
        $fn <: r"(?i)(?:rgb|rgba|hsl|hsla|hwb)",
        register_diagnostic(span=$call, message="Raw color functions are forbidden. Use var(--<role>) from shared-themes.")
    },
    // color-named: never
    CssIdentifier() as $ident where {
        $ident <: within CssGenericProperty(value=$value),
        $ident <: within $value,
        $ident <: r"(?i)(?:aliceblue|antiquewhite|aqua|aquamarine|azure|beige|bisque|black|blanchedalmond|blue|blueviolet|brown|burlywood|cadetblue|chartreuse|chocolate|coral|cornflowerblue|cornsilk|crimson|cyan|darkblue|darkcyan|darkgoldenrod|darkgray|darkgreen|darkgrey|darkkhaki|darkmagenta|darkolivegreen|darkorange|darkorchid|darkred|darksalmon|darkseagreen|darkslateblue|darkslategray|darkslategrey|darkturquoise|darkviolet|deeppink|deepskyblue|dimgray|dimgrey|dodgerblue|firebrick|floralwhite|forestgreen|fuchsia|gainsboro|ghostwhite|gold|goldenrod|gray|green|greenyellow|grey|honeydew|hotpink|indianred|indigo|ivory|khaki|lavender|lavenderblush|lawngreen|lemonchiffon|lightblue|lightcoral|lightcyan|lightgoldenrodyellow|lightgray|lightgreen|lightgrey|lightpink|lightsalmon|lightseagreen|lightskyblue|lightslategray|lightslategrey|lightsteelblue|lightyellow|lime|limegreen|linen|magenta|maroon|mediumaquamarine|mediumblue|mediumorchid|mediumpurple|mediumseagreen|mediumslateblue|mediumspringgreen|mediumturquoise|mediumvioletred|midnightblue|mintcream|mistyrose|moccasin|navajowhite|navy|oldlace|olive|olivedrab|orange|orangered|orchid|palegoldenrod|palegreen|paleturquoise|palevioletred|papayawhip|peachpuff|peru|pink|plum|powderblue|purple|rebeccapurple|red|rosybrown|royalblue|saddlebrown|salmon|sandybrown|seagreen|seashell|sienna|silver|skyblue|slateblue|slategray|slategrey|snow|springgreen|steelblue|tan|teal|thistle|tomato|turquoise|violet|wheat|white|whitesmoke|yellow|yellowgreen)",
        register_diagnostic(span=$ident, message="Named colors are forbidden. Use var(--<role>) from shared-themes.")
    }
}
